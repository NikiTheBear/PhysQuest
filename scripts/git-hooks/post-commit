#!/bin/bash
# 每次提交后自动：同步桌面文档 + 推送当前分支
# 安装：cp scripts/git-hooks/post-commit .git/hooks/ && chmod +x .git/hooks/post-commit
cd "$(git rev-parse --show-toplevel)" || exit 0

# 合并 / 变基过程中不动
[ -d .git/rebase-merge ] && exit 0
[ -d .git/rebase-apply ] && exit 0
[ -f .git/MERGE_HEAD ] && exit 0

# ① 桌面文档同步
DESK="$HOME/Desktop/PhysQuest-本地文档"
if [ -d local ]; then
  mkdir -p "$DESK"
  cp -R local/. "$DESK/" 2>/dev/null
fi

# ② 推送当前分支（main 受保护，推了也会被拒，所以 main 上不推；
#    非 main 分支推送后按需到 scripts/publish.sh 开 PR）
BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
if [ "$BRANCH" = "main" ]; then
  echo "  ↳ main 受保护，跳过自动推送（用 scripts/publish.sh 走分支 + PR）"
  exit 0
fi

if git push -u origin "$BRANCH" > /tmp/physquest-hook-push.err 2>&1; then
  echo "  ↳ 已自动推送到分支 $BRANCH"
else
  if grep -qi "could not read Username\|Device not configured\|Authentication" /tmp/physquest-hook-push.err; then
    echo "  ↳ 未推送：还没登录 GitHub（双击桌面「PhysQuest-登录GitHub.command」）"
  else
    echo "  ↳ 未推送：$(head -1 /tmp/physquest-hook-push.err)"
  fi
fi
