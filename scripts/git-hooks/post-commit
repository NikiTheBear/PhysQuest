#!/bin/bash
# 每次提交后自动：同步桌面文档 + 推送 GitHub
# 安装：cp scripts/git-hooks/post-commit .git/hooks/ && chmod +x .git/hooks/post-commit
cd "$(git rev-parse --show-toplevel)" || exit 0

# 合并 / 变基过程中不推送
[ -d .git/rebase-merge ] && exit 0
[ -d .git/rebase-apply ] && exit 0
[ -f .git/MERGE_HEAD ] && exit 0

# ① 桌面文档同步
DESK="$HOME/Desktop/PhysQuest-本地文档"
if [ -d local ]; then
  mkdir -p "$DESK"
  cp -R local/. "$DESK/" 2>/dev/null
fi

# ② 推送（失败不打断工作，只提示一行）
if git push origin main > /tmp/physquest-hook-push.err 2>&1; then
  echo "  ↳ 已自动推送到 GitHub"
else
  if grep -qi "could not read Username\|Device not configured\|Authentication failed" /tmp/physquest-hook-push.err; then
    echo "  ↳ 未推送：还没登录 GitHub（双击桌面「PhysQuest-登录GitHub.command」输一次令牌）"
  else
    echo "  ↳ 未推送：$(head -1 /tmp/physquest-hook-push.err)"
  fi
fi
