{
  "labId": "optics-lens",
  "scripts": [
    {
      "id": "demo-equal-2f",
      "title": "推过二倍焦距，看像由小变大",
      "steps": [
        {
          "stepIndex": 1,
          "knowledgePoint": "K-O2-05",
          "narration": "先把蜡烛放在两倍焦距以外。像又小又近，倒立着。这就是照相机看到的世界。",
          "targetParams": { "u": 30, "f": 10, "screenX": 15 },
          "highlightRigIds": ["candle", "screen", "image"],
          "durationMs": 3200
        },
        {
          "stepIndex": 2,
          "knowledgePoint": "K-O2-06",
          "narration": "慢慢推近。当蜡烛正好走到两倍焦距处，像和物一样大了——这是唯一一个「不好也不小」的位置。",
          "targetParams": { "u": 20, "f": 10, "screenX": 20 },
          "highlightRigIds": ["lens", "image"],
          "durationMs": 3200
        },
        {
          "stepIndex": 3,
          "knowledgePoint": "K-O2-07",
          "narration": "继续推近，但别越过焦点。像变得比物还大，光屏也必须往更远处挪才能接住它。",
          "targetParams": { "u": 15, "f": 10, "screenX": 30 },
          "highlightRigIds": ["candle", "image"],
          "durationMs": 3400
        },
        {
          "stepIndex": 4,
          "knowledgePoint": "K-O2-11",
          "narration": "记住这个规律：物近、像远、像变大。反过来就是照相机对焦时镜头的动作。",
          "targetParams": { "u": 12, "f": 10, "screenX": 60 },
          "highlightRigIds": ["screen"],
          "durationMs": 3000
        }
      ]
    },
    {
      "id": "demo-magnify",
      "title": "越靠近焦点，像越大",
      "steps": [
        {
          "stepIndex": 1,
          "knowledgePoint": "K-O2-06",
          "narration": "从两倍焦距起步，像是等大的。",
          "targetParams": { "u": 20, "f": 10, "screenX": 20 },
          "highlightRigIds": ["image"],
          "durationMs": 2600
        },
        {
          "stepIndex": 2,
          "knowledgePoint": "K-O2-07",
          "narration": "推到一点五倍焦距。像变成两倍大，光屏要退到 30 cm。",
          "targetParams": { "u": 15, "f": 10, "screenX": 30 },
          "highlightRigIds": ["image", "screen"],
          "durationMs": 3000
        },
        {
          "stepIndex": 3,
          "knowledgePoint": "K-O2-11",
          "narration": "再往前挪到 1.2 倍焦距。像涨到 5 倍，光屏得退到 60 cm——这就是为什么投影仪要离墙那么远。",
          "targetParams": { "u": 12, "f": 10, "screenX": 60 },
          "highlightRigIds": ["screen", "image"],
          "durationMs": 3400
        }
      ]
    },
    {
      "id": "demo-no-image",
      "title": "三种让光屏上什么都没有的办法",
      "steps": [
        {
          "stepIndex": 1,
          "knowledgePoint": "K-O2-08",
          "narration": "第一种：把蜡烛正好放在焦点上。出射光线互相平行，交点跑到无穷远去了。",
          "targetParams": { "u": 10, "f": 10, "screenX": 20 },
          "highlightRigIds": ["ray1", "ray2", "ray3"],
          "durationMs": 3600
        },
        {
          "stepIndex": 2,
          "knowledgePoint": "K-O2-09",
          "narration": "第二种：把蜡烛挪进焦距以内。这时候成的是虚像，光屏怎么也接不住。",
          "targetParams": { "u": 6, "f": 10, "screenX": 30 },
          "highlightRigIds": ["image", "screen"],
          "durationMs": 3600
        },
        {
          "stepIndex": 3,
          "knowledgePoint": "K-O2-13",
          "narration": "第三种：什么都不动，只把光屏挪到很远的地方。像其实还在那里，只是糊成一团光斑。",
          "targetParams": { "u": 30, "f": 10, "screenX": 90 },
          "highlightRigIds": ["screen"],
          "durationMs": 3200
        }
      ]
    },
    {
      "id": "demo-mask-half",
      "title": "遮住一半，像不会少一半",
      "steps": [
        {
          "stepIndex": 1,
          "knowledgePoint": "K-O2-13",
          "narration": "先看清楚：这是一张完整的像。注意它的位置和大小。",
          "targetParams": { "u": 30, "f": 10, "screenX": 15, "maskTop": false },
          "highlightRigIds": ["image", "screen"],
          "durationMs": 3000
        },
        {
          "stepIndex": 2,
          "knowledgePoint": "K-O2-04",
          "narration": "现在遮住透镜的上半部分。",
          "targetParams": { "u": 30, "f": 10, "screenX": 15, "maskTop": true },
          "highlightRigIds": ["lens"],
          "durationMs": 3600
        },
        {
          "stepIndex": 3,
          "knowledgePoint": "K-O2-13",
          "narration": "看清楚：像的位置没变，大小没变，形状也没变——只是整体变暗了。因为像由物距和焦距决定，跟透镜的通光面积无关。",
          "targetParams": { "u": 30, "f": 10, "screenX": 15, "maskTop": true },
          "highlightRigIds": ["image"],
          "durationMs": 4200
        }
      ]
    },
    {
      "id": "demo-virtual-image",
      "title": "虚像：光屏接不住，但眼睛看得到",
      "steps": [
        {
          "stepIndex": 1,
          "knowledgePoint": "K-O2-07",
          "narration": "先看正常的实像：光线真的在光屏那里交了叉。",
          "targetParams": { "u": 15, "f": 10, "screenX": 30 },
          "highlightRigIds": ["image", "screen"],
          "durationMs": 3000
        },
        {
          "stepIndex": 2,
          "knowledgePoint": "K-O2-09",
          "narration": "把蜡烛推过焦点。出射光线变成发散的，不再相交。看虚线——它们反向延长才交于一点，这就是虚像。",
          "targetParams": { "u": 6, "f": 10, "screenX": 30 },
          "highlightRigIds": ["image", "ray1"],
          "durationMs": 4200
        },
        {
          "stepIndex": 3,
          "knowledgePoint": "K-O2-10",
          "narration": "虚像在透镜左边，正立，比物还大。它接不住，但你把眼睛凑到透镜右边就能看见——这就是放大镜。",
          "targetParams": { "u": 6, "f": 10, "screenX": 30 },
          "highlightRigIds": ["lens", "image"],
          "durationMs": 3800
        }
      ]
    }
  ]
}
